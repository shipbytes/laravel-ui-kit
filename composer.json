{
    "name": "shipbytes/laravel-ui-kit",
    "description": "Admin panel + auth UI kit for Laravel 12+ with Livewire 3, Volt, and Tailwind 4. Modular installers for optional features.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "volt", "admin", "auth", "tailwind", "ui-kit"],
    "homepage": "https://github.com/shipbytes/laravel-ui-kit",
    "support": {
        "issues": "https://github.com/shipbytes/laravel-ui-kit/issues",
        "source": "https://github.com/shipbytes/laravel-ui-kit"
    },
    "authors": [
        {
            "name": "Abhishek",
            "email": "abhiguess@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "laravel/fortify": "^1.25",
        "laravel/prompts": "^0.3.0",
        "livewire/livewire": "^3.6",
        "livewire/volt": "^1.7",
        "propaganistas/laravel-disposable-email": "^2.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Required when installing the admin-middleware module",
        "spatie/laravel-activitylog": "Required when installing the activity-log module",
        "lab404/laravel-impersonate": "Required when installing the impersonation module"
    },
    "autoload": {
        "psr-4": {
            "Shipbytes\\UiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipbytes\\UiKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shipbytes\\UiKit\\UiKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
